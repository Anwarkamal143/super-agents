{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anwarkamal143/super-agents/blob/main/factory/board.schema.json",
  "title": "Super Agents Factory Board",
  "description": "Durable task board. The orchestrator session is the sole writer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "factory",
    "status",
    "tasks",
    "decisions",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "request",
        "orchestrator",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "request": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "orchestrator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "enum": [
        "planning",
        "awaiting_approval",
        "running",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "status",
          "dependsOn",
          "acceptanceCriteria",
          "owner",
          "attempts",
          "maxAttempts",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "running",
              "blocked",
              "needs_approval",
              "succeeded",
              "failed",
              "skipped",
              "interrupted"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "outcome",
                "summary",
                "observedAt"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "command",
                    "test",
                    "typecheck",
                    "review",
                    "artifact",
                    "human-decision",
                    "other"
                  ]
                },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "blocked",
                    "skipped",
                    "not-run",
                    "unknown"
                  ]
                },
                "summary": {
                  "type": "string",
                  "maxLength": 4000
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "artifact": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          },
          "approvalRequired": {
            "type": "boolean",
            "default": true
          },
          "recoveryNote": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "outcome",
          "actor",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "outcome": {
            "enum": [
              "approved",
              "denied",
              "revoked"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time"
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
